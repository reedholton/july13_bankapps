{
  "info": {
    "name": "Simple Bank Application API (with Auth)",
    "description": "Every request except /api/auth/** now requires a Bearer token. Run top to bottom - registration/login requests capture tokens automatically into collection variables used by later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "aliceToken", "value": "" },
    { "key": "bobToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "accountId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "1. Register Alice",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.collectionVariables.set('aliceToken', body.token);",
            "pm.test('Status is 201', () => pm.response.to.have.status(201));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Alice Anderson\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"alice123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "2. Register Bob",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.collectionVariables.set('bobToken', body.token);",
            "pm.test('Status is 201', () => pm.response.to.have.status(201));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Bob Brown\",\n  \"email\": \"bob@example.com\",\n  \"password\": \"bob12345\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "3. Login as Admin (seeded on startup)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.collectionVariables.set('adminToken', body.token);",
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Role is ADMIN', () => pm.expect(body.role).to.eql('ADMIN'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@simplebank.local\",\n  \"password\": \"ChangeMe123!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Alice's normal usage",
      "item": [
        {
          "name": "4. Create Account (Alice)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.collectionVariables.set('accountId', body.accountId);",
            "pm.test('Status is 201', () => pm.response.to.have.status(201));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"accountType\": \"SAVINGS\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          }
        },
        {
          "name": "5. Get My Accounts (Alice)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          }
        },
        {
          "name": "6. Deposit (Alice, own account)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Balance is 500', () => pm.expect(body.balance).to.equal(500));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 500\n}" },
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}/deposit", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}", "deposit"] }
          }
        },
        {
          "name": "7. Withdraw (Alice, own account)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Balance is 300', () => pm.expect(body.balance).to.equal(300));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 200\n}" },
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}/withdraw", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}", "withdraw"] }
          }
        },
        {
          "name": "8. Get Transactions (Alice, own account)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Has 2 transactions', () => pm.expect(pm.response.json().length).to.equal(2));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}/transactions", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}", "transactions"] }
          }
        }
      ]
    },
    {
      "name": "Ownership + RBAC checks",
      "item": [
        {
          "name": "9. [Negative] Get Account - No Token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 403 Access Forbidden', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}"] }
          }
        },
        {
          "name": "10. [Negative] Get Account - Bob tries Alice's account",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 403 (not owner, not admin)', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bobToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}"] }
          }
        },
        {
          "name": "11. Get Account - Admin CAN view Alice's account",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200 (admin bypasses ownership check)', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}"] }
          }
        },
        {
          "name": "12. [Negative] Admin Route - Bob is not an admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 403', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bobToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/accounts", "host": ["{{baseUrl}}"], "path": ["api", "admin", "accounts"] }
          }
        },
        {
          "name": "13. Admin - Get All Accounts",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/accounts", "host": ["{{baseUrl}}"], "path": ["api", "admin", "accounts"] }
          }
        },
        {
          "name": "14. Admin - Get All Users",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        }
      ]
    },
    {
      "name": "Validation + error cases",
      "item": [
        {
          "name": "15. [Negative] Register - Duplicate Email",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 409', () => pm.response.to.have.status(409));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Alice Again\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"whatever1\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "16. [Negative] Register - Password Too Short",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 400', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Charlie\",\n  \"email\": \"charlie@example.com\",\n  \"password\": \"abc\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "17. [Negative] Login - Wrong Password",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"wrong-password\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "18. [Negative] Withdraw More Than Balance",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 400', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 999999\n}" },
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}/withdraw", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}", "withdraw"] }
          }
        },
        {
          "name": "19. [Negative] Deposit Negative Amount",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 400', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": -50\n}" },
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}/deposit", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}", "deposit"] }
          }
        }
      ]
    }
  ]
}
